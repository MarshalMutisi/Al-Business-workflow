# Copy to .env and fill in. Never commit .env.

# Shared secret your email provider sends in the X-Webhook-Secret header
WEBHOOK_SECRET=change-me
# Key for the admin endpoints (/emails, approvals, retry), sent as X-API-Key
ADMIN_API_KEY=change-me-too

# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
# The secret key (sb_secret_...) or legacy service_role key. Server-side only!
SUPABASE_SERVICE_ROLE_KEY=

# Supabase dashboard -> Connect -> Session pooler (port 5432), not the transaction pooler (6543).
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Plans below this classification confidence need human approval
APPROVAL_CONFIDENCE_THRESHOLD=0.75
# Set to true to require approval for every email (recommended while testing)
ALWAYS_REQUIRE_APPROVAL=false

# LangSmith tracing (https://smith.langchain.com -> Settings -> API Keys).
# LangChain/LangGraph send a trace of every agent run when LANGSMITH_TRACING=true.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-business-workflow
# EU region only: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
