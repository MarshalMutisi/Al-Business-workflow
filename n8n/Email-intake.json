      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const data = item.json;\n\n  const from = data.From ?? \"\";\n\n  const match = from.match(/^(.*?)\\s*<([^>]+)>$/);\n\n  item.json = {\n    message_id: data.id ?? \"\",\n    thread_id: data.threadId ?? \"\",\n    from_name: match ? match[1].trim() : \"\",\n    from_email: match ? match[2].trim() : from.trim(),\n    to: data.To ?? \"\",\n    subject: data.Subject ?? \"\",\n    body_text: data.snippet ?? \"\",\n    received_at: data.internalDate\n      ? new Date(Number(data.internalDate)).toISOString()\n      : \"\",\n    attachments: []\n  };\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -960,
